# systemd unit for the ROV-side program.
#
# Installed by scripts/deploy_pi.sh, which fills in @USER@ and @DIR@.
# Deliberately NOT enabled at boot: the program arms the vehicle on start-up,
# so start it by hand when the ROV is ready:
#     sudo systemctl start rov-pi
#     journalctl -u rov-pi -f

[Unit]
Description=pysub ROV control (Pi side)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@DIR@/rov.env
ExecStart=@DIR@/.venv/bin/python @DIR@/pi/main.py
# SIGINT runs the normal shutdown path: neutral -> disarm -> close.
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
